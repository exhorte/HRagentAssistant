# HRagentAssistant - example configuration. Copy to `.env` and fill in only what you need.
# The prototype runs with NO key at all (extractive answers, offline hashing embeddings, local Qdrant).
# Never commit a real `.env`.

# --- Where runtime data (SQLite DB, uploaded files, local Qdrant index) is stored ---
# HR_DATA_DIR=data/runtime

# --- LLM: none | groq | portkey ----------------------------------------------------
# none    -> deterministic extractive answers (default, offline, no cost)
# groq    -> Groq directly (needs GROQ_API_KEY)
# portkey -> Groq through the Portkey gateway (needs PORTKEY_API_KEY and a provider slug)
LLM_PROVIDER=none
# LLM_MODEL_NAME=openai/gpt-oss-20b
# GROQ_API_KEY=
# PORTKEY_API_KEY=
# PORTKEY_PROVIDER=@hrpolicy

# Optional safety-model check on questions/answers (can only make decisions stricter).
# GUARD_LLM_ENABLED=false
# GUARD_MODEL_NAME=openai/gpt-oss-safeguard-20b

# --- Embeddings: hashing | jina ------------------------------------------------------
# hashing -> offline, deterministic, lexical only (default)
# jina    -> semantic, needs JINA_API_KEY. Use a MULTILINGUAL model for French documents.
EMBEDDING_BACKEND=hashing
# EMBEDDING_MODEL_NAME=jina-embeddings-v2-base-en
# JINA_API_KEY=

# --- Vector store: memory | local | cloud ----------------------------------------------
# local -> embedded Qdrant persisted under HR_DATA_DIR (default; one process at a time)
QDRANT_MODE=local
# QDRANT_URL=
# QDRANT_API_KEY=
# QDRANT_COLLECTION_NAME=hr_documents

# --- Retrieval tuning (calibrated for the offline `hashing` backend) -------------------
# CHUNK_SIZE=800
# CHUNK_OVERLAP=100
# TOP_K_RESULTS=4
# MIN_SCORE=0.12
# MIN_COVERAGE=0.5

# --- Tracing (LangSmith): OFF by default. Traces contain prompts and HR passages. ------
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=hr-assistant
